# Build artifacts
/target/
/dist/
/log/

# vex-cloudsync.exe compile a part (autre repo, binaire Windows) puis copie
# ici a la main pour /api/appareil/telecharger -- jamais dans git.
/static/downloads/

# Sauvegardes DB (mysqldump) -- contiennent tout, jamais dans git
/backups/

# Images/medias uploades par les utilisateurs via les blocs Sitec (voir
# enregistrer_media dans sitec.rs) -- contenu genere a l'usage, propre a
# chaque serveur, jamais dans git.
/static/sitec_media/

# Secrets & config locale
db.json
config.json
keys/*
!keys/.gitkeep
static/onlyoffice/data/*.key

# Paiement reel (Stripe) : service volontairement SEPARE de VEX, jamais
